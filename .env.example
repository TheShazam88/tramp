APP_NAME=TRAMP API
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password
ENVIRONMENT=local
PUBLIC_BASE_URL=http://localhost:8080
CADDY_HTTP_PORT=8080

APP_SECRET=replace-with-at-least-32-random-bytes
ALLOW_SELF_SIGNUP=false

POSTGRES_DB=travelwatch
POSTGRES_USER=travelwatch
POSTGRES_PASSWORD=travelwatch
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://travelwatch:travelwatch@postgres:5432/travelwatch

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

KEY_UNLOCK_MODE=master_key
MASTER_KEY_SOURCE=local_file
AUTO_UNLOCK_LOCAL_FILE_PATH=.tramp-auto-unlock.key
AUTO_UNLOCK_SEED_MATERIAL=
VITE_API_BASE_URL=/api/v1
VITE_API_MODE=live

# Optional Vault profile. Leave blank for v1 local startup.
VAULT_ADDR=
VAULT_TOKEN=
VAULT_DEV_ROOT_TOKEN_ID=travel-watch-dev-token
VAULT_PORT=8200

EMAIL_PROVIDER=disabled
SES_REGION=
ALERT_FROM_ADDRESS=alerts@travel.local
TELEGRAM_BOT_TOKEN=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

DUFFEL_ACCESS_TOKEN=
DUFFEL_ENV=test
KIWI_TEQUILA_API_KEY=
TRAVELPAYOUTS_TOKEN=
SKYSCANNER_AFFILIATE_KEY=

EPS_API_KEY=
EPS_SHARED_SECRET=
BOOKING_DEMAND_API_KEY=
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=

DEFAULT_LUXURY_VS_SAVINGS=0.6
DEFAULT_QUALITY_FLOOR=40
DEFAULT_BAND_TOLERANCE=0.10
TARGET_PERCENTILE=25
GLIDE_START_DAYS=42
GLIDE_END_DAYS=3

GLOBAL_MAX_AUTO_BOOK_AMOUNT=
WEEKLY_MAX_SPEND=
WEEKLY_MAX_BOOKINGS=

ANTHROPIC_API_KEY=

SCRAPE_ENABLED=false
AIRBNB_DATA_API_KEY=
RESIDENTIAL_PROXY_URL=
